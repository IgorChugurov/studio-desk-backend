# Copy to .env and fill in. .env is never committed.

# Runtime mode: development | test | production
APP_ENV=development
# HTTP port of the Nest application
PORT=3000

# PostgreSQL address
DB_HOST=localhost
DB_PORT=5432
# Main database name (tests use studio_desk_test)
DB_NAME=studio_desk

# Passwords of the PostgreSQL users (see 03-architecture/backend-structure.md)
# studio_desk_owner: owns tables, runs migrations only
DB_OWNER_PASSWORD=change-me-owner
# platform_api: platform admin API
DB_PLATFORM_API_PASSWORD=change-me-platform
# studio_api: studio admin API
DB_STUDIO_API_PASSWORD=change-me-studio
# public_api: public API
DB_PUBLIC_API_PASSWORD=change-me-public

# Used only by docker-compose: password of the PostgreSQL superuser in the
# local container. The application never connects with it.
POSTGRES_SUPERUSER_PASSWORD=change-me-superuser

# Sign-in codes via Resend. Create a StudioDesk API key in the Resend
# dashboard. Never commit the real key.
RESEND_API_KEY=change-me-resend
RESEND_FROM_EMAIL=StudioDesk <noreply@axondigital.xyz>

# Platform administrator. The row is created from this address after migrations.
PLATFORM_ADMIN_EMAIL=admin@example.com
# Secret that signs the 15-minute access token. At least 32 characters.
# On the server it is generated there; do not copy it from this file.
ACCESS_TOKEN_SECRET=change-me-access-token-secret-32chars

# Extra browser origins allowed by CORS, comma-separated (optional). For a
# frontend running on a developer machine, for example http://admin.localhost:3001.
# Not set by default: only the two production frontends are allowed.
CORS_EXTRA_ORIGINS=
