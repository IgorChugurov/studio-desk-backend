{
  "info": {
    "name": "StudioDesk Platform",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "host", "value": "http://localhost:3000/api/platform" },
    { "key": "email", "value": "admin@example.com" },
    { "key": "code", "value": "" },
    { "key": "accessToken", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Request code",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\"\n}"
            },
            "url": "{{host}}/auth/code"
          }
        },
        {
          "name": "Sign in",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"code\": \"{{code}}\"\n}"
            },
            "url": "{{host}}/auth/sign-in"
          }
        },
        {
          "name": "Refresh",
          "request": {
            "method": "POST",
            "header": [{ "key": "X-Requested-With", "value": "fetch" }],
            "url": "{{host}}/auth/refresh"
          }
        },
        {
          "name": "Sign out",
          "request": {
            "method": "POST",
            "header": [{ "key": "X-Requested-With", "value": "fetch" }],
            "url": "{{host}}/auth/sign-out"
          }
        }
      ]
    }
  ]
}
